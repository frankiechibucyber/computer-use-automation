# Copy to .env and fill in. The discovery phase needs an LLM behind an OpenAI-style chat API.
# Replay needs NONE of this — the model is removed from the production path.

# Required for `cua discover` (read from the environment only; never commit a real key):
OPENROUTER_KEY=sk-or-...

# Optional overrides (defaults shown):
# OR_MODEL=openai/gpt-4o-mini
# OR_BASE_URL=https://openrouter.ai/api/v1/chat/completions
